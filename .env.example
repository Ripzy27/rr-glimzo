# Copy to .env and fill in. Never commit .env.
PORT=3001
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-long-passphrase
# Any long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=
# SQLite file location
DB_PATH=data/glimzo.db
# Set to true when running behind a reverse proxy (nginx, Caddy, a host's load balancer)
# TRUST_PROXY=true
